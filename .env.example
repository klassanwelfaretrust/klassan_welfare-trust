# Klassan Welfare Trust — Firebase configuration.
# HONESTY: Firebase is NOT configured in this repository. Copy this file to
# .env, fill in values from Firebase Console > Project settings > Your apps >
# Web app, and never commit .env. The app refuses to boot without these keys.
# Get them: docs/SETUP_FIREBASE.md
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional (Analytics / Measurement)
VITE_FIREBASE_MEASUREMENT_ID=

# FREE LOCAL PREVIEW (emulator) — no real Firebase project, no payment.
# To preview on your own computer with the Firebase emulators, add this
# line to your .env (the demo values are built into src/firebase/config.ts,
# so the six keys above can stay empty in emulator mode):
# VITE_USE_EMULATOR=true
# Full steps: klassan-audit/EMULATOR_GUIDE_BEGINNER.md
